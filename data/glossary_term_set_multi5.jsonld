    },
    {
     "@value": "천간",
     "@language": "ko"
    }
   ],
   "alternateName": [
    {
     "@value": "heavenly stems",
     "@language": "en"
    }
   ],
   "termCode": [
    {
     "@value": "天文基础 · 时间系统",
     "@language": "zh-Hans"
    },
    {
     "@value": "天文基礎 · 時間系統",
     "@language": "zh-Hant"
    },
    {
     "@value": "Fundamentals · time systems",
     "@language": "en"
    },
    {
     "@value": "天文基礎 · 時間体系",
     "@language": "ja"
    },
    {
     "@value": "천문 기초 · 시간 체계",
     "@language": "ko"
    }
   ],
   "description": [
    {
     "@value": "甲、乙、丙、丁、戊、己、庚、辛、壬、癸，共十个。",
     "@language": "zh-Hans"
    },
    {
     "@value": "甲、乙、丙、丁、戊、己、庚、辛、壬、癸，共十個。",
     "@language": "zh-Hant"
    },
    {
     "@value": "The ten: jia, yi, bing, ding, wu, ji, geng, xin, ren, gui.",
     "@language": "en"
    },
    {
     "@value": "甲・乙・丙・丁・戊・己・庚・辛・壬・癸の十個。",
     "@language": "ja"
    },
    {
     "@value": "갑·을·병·정·무·기·경·신·임·계, 모두 열 개.",
     "@language": "ko"
    }
   ],
   "inDefinedTermSet": "https://github.com/Kuangchujia/chinese-calendar-glossary#group-4"
  },
  {
   "@type": "DefinedTerm",
   "identifier": "56",
