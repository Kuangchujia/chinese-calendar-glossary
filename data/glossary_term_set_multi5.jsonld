    },
    {
     "@value": "Sexagenary Day-Count",
     "@language": "en"
    },
    {
     "@value": "干支紀日",
     "@language": "ja"
    },
    {
     "@value": "간지기일(干支紀日)",
     "@language": "ko"
    }
   ],
   "alternateName": [
    {
     "@value": "Sexagenary Day-Count",
