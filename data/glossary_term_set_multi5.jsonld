   ],
   "alternateName": [
    {
     "@value": "White Tiger",
     "@language": "en"
    }
   ],
   "termCode": [
    {
     "@value": "星宿与星官 · 二十八宿",
     "@language": "zh-Hans"
    },
    {
     "@value": "星宿與星官 · 二十八宿",
