    {
     "@value": "천문 기초 · 시간 체계",
     "@language": "ko"
    }
   ],
   "description": [
    {
     "@value": "十二时称之一，寅时，今三时至五时，是夜与日交替之际。",
     "@language": "zh-Hans"
    },
    {
     "@value": "十二時稱之一，寅時，今三時至五時，是夜與日交替之際。",
     "@language": "zh-Hant"
    },
    {
     "@value": "The yin hour, 03:00 to 05:00, where night gives way to day.",
     "@language": "en"
    },
    {
     "@value": "十二時称の一つ、寅の刻。今の三時から五時。夜と日が交替する際である。",
     "@language": "ja"
    },
    {
     "@value": "십이시칭의 하나, 인시. 오늘의 3시에서 5시. 밤과 낮이 교대하는 즈음이다.",
     "@language": "ko"
    }
   ],
   "inDefinedTermSet": "https://github.com/Kuangchujia/chinese-calendar-glossary#group-15"
  },
  {
   "@type": "DefinedTerm",
   "identifier": "234",
   "name": [
    {
     "@value": "日出",
     "@language": "zh-Hans"
    },
    {
     "@value": "日出",
     "@language": "zh-Hant"
    },
    {
     "@value": "sunrise",
     "@language": "en"
    },
    {
     "@value": "日出",
     "@language": "ja"
    },
    {
     "@value": "일출",
     "@language": "ko"
    }
   ],
   "alternateName": [
    {
     "@value": "sunrise",
