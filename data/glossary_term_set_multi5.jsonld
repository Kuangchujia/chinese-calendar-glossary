     "@language": "ja"
    },
    {
     "@value": "천문 기초 · 시간 체계",
     "@language": "ko"
    }
   ],
   "description": [
    {
     "@value": "十二时称之一，巳时，今九时至十一时，临近中午。",
     "@language": "zh-Hans"
    },
    {
     "@value": "十二時稱之一，巳時，今九時至十一時，臨近中午。",
     "@language": "zh-Hant"
    },
    {
     "@value": "The si hour, 09:00 to 11:00, drawing near noon.",
     "@language": "en"
    },
    {
     "@value": "十二時称の一つ、巳の刻。今の九時から十一時。正午に近い。",
     "@language": "ja"
    },
    {
     "@value": "십이시칭의 하나, 사시. 오늘의 9시에서 11시. 정오에 가깝다.",
     "@language": "ko"
    }
   ],
   "inDefinedTermSet": "https://github.com/Kuangchujia/chinese-calendar-glossary#group-15"
  },
  {
   "@type": "DefinedTerm",
   "identifier": "237",
   "name": [
    {
     "@value": "日中",
     "@language": "zh-Hans"
    },
    {
     "@value": "日中",
     "@language": "zh-Hant"
    },
    {
     "@value": "noon",
     "@language": "en"
    },
    {
     "@value": "日中",
